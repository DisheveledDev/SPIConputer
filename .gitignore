# SPIComputer card projects build into their own build/ folder; the
# assembled card image (software/sdcard) is generated by software/install.sh.
software/*/build/
software/sdcard/

# The IDE vendor script builds the simulator here (scripts/update-vendor.sh).
simulator/build-vendor/
